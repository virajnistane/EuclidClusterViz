Bootstrap: docker
From: python:3.14-slim

# Build from the ClusterViz/ directory (paths under %files are relative to it):
#     make sif
# or  apptainer build --fakeroot clusterviz.sif Singularity.def

%labels
    Author Viraj Nistane
    Description ClusterViz Dash app — Euclid cluster visualization
    Version 1.4.0

%files
    # Only what the app needs at run time. Copying "." would also pull in .env,
    # config_local.ini, tmp/, logs, tests/ and docs/ — never do that.
    pyproject.toml /app/pyproject.toml
    uv.lock /app/uv.lock
    config.ini /app/config.ini
    cluster_visualization/__init__.py /app/cluster_visualization/__init__.py
    cluster_visualization/callbacks /app/cluster_visualization/callbacks
    cluster_visualization/core /app/cluster_visualization/core
    cluster_visualization/scripts /app/cluster_visualization/scripts
    cluster_visualization/src /app/cluster_visualization/src
    cluster_visualization/ui /app/cluster_visualization/ui
    cluster_visualization/utils /app/cluster_visualization/utils

%post
    set -e

    # Every compiled dependency (numpy, scipy, healpy, astropy, shapely, pyarrow, ...)
    # ships a cp314 manylinux wheel in uv.lock, so no compilers are needed.
    pip install --no-cache-dir "uv>=0.10.11"

    # Install the exact versions from uv.lock into /opt/venv. The app itself is not
    # installed as a package: it runs from /app via PYTHONPATH, like launch.sh does.
    cd /app
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
        uv sync --frozen --no-dev --no-install-project --python /usr/local/bin/python3.14

    # Drop host bytecode caches and precompile the app (the image is read-only at run time)
    find /app -name __pycache__ -type d -prune -exec rm -rf {} +
    rm -rf /app/cluster_visualization/.ruff_cache
    /opt/venv/bin/python -m compileall -q /app/cluster_visualization

    # core/app.py writes tmp/browser_debug.log under the project root; /app is
    # read-only inside the image, so point it at the container's /tmp.
    ln -s /tmp /app/tmp

%environment
    export VIRTUAL_ENV=/opt/venv
    export PATH=/opt/venv/bin:$PATH
    export PYTHONPATH=/app:$PYTHONPATH
    export PYTHONDONTWRITEBYTECODE=1

%runscript
    # Make a relative --config path absolute before changing to /app, and fall back
    # to the config.ini baked into the image when no --config is given.
    has_config=
    prev=
    n=$#
    while [ "$n" -gt 0 ]; do
        arg=$1
        shift
        n=$((n - 1))
        if [ "$prev" = "--config" ]; then
            case $arg in /*) ;; *) arg="$PWD/$arg" ;; esac
        fi
        case $arg in
            --config) has_config=1 ;;
            --config=/*) has_config=1 ;;
            --config=*) has_config=1; arg="--config=$PWD/${arg#--config=}" ;;
        esac
        set -- "$@" "$arg"
        prev=$arg
    done
    [ -n "$has_config" ] || set -- --config /app/config.ini "$@"

    cd /app
    exec python cluster_visualization/src/cluster_dash_app.py "$@"

%help
    ClusterViz Apptainer image.

    Build (from the ClusterViz/ directory):
        make sif

    Simplest: copy launch_sif.sh next to the image and run it; it binds the
    paths below that exist on the host and passes other options through:
        ./launch_sif.sh --config my_config.ini

    Or by hand (port 8050 + UID % 1000):
        apptainer run --bind /sps,/pbs,/cvmfs clusterviz.sif

    Run with your own config:
        apptainer run --bind /sps,/pbs,/cvmfs clusterviz.sif --config my_config.ini

    Binds (CC-IN2P3 does not mount $HOME into the container on its own):
        /sps    Euclid data (base_workspace, CATRED, mosaics, masks)
        /pbs    $HOME: the disk caches in ~/.cache/clusterviz* (startup fails
                without them) and any config or catalogue files kept there
        /cvmfs  RichCL parameters for the cluster-members "Magnitude limit"
                switch; without it that filter is silently skipped

    Other app options pass through, e.g. --external, --log-level DEBUG.
